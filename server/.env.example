# Server port (Render injects PORT automatically in production)
PORT=3001

# Environment mode: development or production
NODE_ENV=development

# Allowed frontend origin(s) for CORS (comma-separated: production Vercel URL + preview branch URL(s), supports wildcards like https://susu-circle-*.vercel.app)
CLIENT_URL=http://localhost:5173

# Signing secret for JWT tokens (generate a NEW, separate secret for production)
JWT_SECRET=replace-with-a-long-random-secret

# MongoDB Atlas connection string:
# - Local development database: .../susu-dev?...
# - Production database on Render: .../susu-prod?...
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/susu-dev?retryWrites=true&w=majority
